# Where the data comes from: "sample" (default, no credentials needed) or "shopify"
DATA_SOURCE=sample

# Port the app listens on. It always listens on 127.0.0.1 only (see README, "Security notes").
PORT=3000

# Who is allowed in, and with which role. Copy roles.example.json to roles.json and edit it.
ROLES_FILE=roles.json

# Only needed when DATA_SOURCE=shopify
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-07

# Stock at or below this number counts as low
LOW_STOCK_THRESHOLD=2
